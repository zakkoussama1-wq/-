# Copy to shopify.app.toml, then replace both placeholders before linking.
# Standalone Next.js app: the existing merchant login and OAuth flow are retained.
client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
name = "DZ Lead Form Pro"
application_url = "https://REPLACE_WITH_YOUR_HTTPS_HOST/dashboard"
embedded = false

[access_scopes]
scopes = "read_products"
# Optional order sync; request through OAuth only after explicitly enabling it.
optional_scopes = ["write_orders"]
# Keep the existing explicit authorization-code grant flow.
use_legacy_install_flow = true

[auth]
redirect_urls = ["https://REPLACE_WITH_YOUR_HTTPS_HOST/api/integrations/shopify/callback"]

[webhooks]
api_version = "2026-10"

[build]
automatically_update_urls_on_dev = false
