# Use secure runtime settings; never commit real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Default: verified TLS. Only on Render with its short Internal Database URL:
# DATABASE_SSL_MODE=render-internal
# RENDER is supplied by Render; do not set it to bypass the runtime guard.
SHOPIFY_SHOP=h8vsym-t0.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters; preserve across restores.
INTEGRATIONS_ENCRYPTION_KEY=

# Product media: persistent local disk, never a build directory. Local demo defaults to data/local-demo/media.
MEDIA_STORAGE_DRIVER=local
# MEDIA_STORAGE_PATH=/absolute/path/to/persistent/media
MEDIA_MAX_IMAGE_BYTES=5242880
# Exact trusted public HTTPS CDN hostnames only, revalidated on every redirect.
MEDIA_REMOTE_HOSTS=images.unsplash.com,images.pexels.com

# Off by default. Enable only after reviewing offline write_orders authorization,
# protected customer data access, schema checks and the pending-order workflow.
DZ_SHOPIFY_ORDER_SYNC=0
# Separate opt-in for the new Shopify Admin UI; never enables order creation.
DZ_SHOPIFY_EMBEDDED=0
# Safe default: no sending until one local UUID is configured AND bound in PostgreSQL.
DZ_SHOPIFY_ORDER_SYNC_MODE=single_order
DZ_SHOPIFY_ORDER_TRIAL_ID=
# Only BYPASS is currently supported. Other policies fail closed.
DZ_SHOPIFY_ORDER_INVENTORY_POLICY=BYPASS
